  "narrative": {
    "northStar": "La Línea UCO360",
    "overview": "El servicio es una línea de transporte: estaciones (soporte, infraestructura, seguridad, gestión), un recorrido continuo y una terminal que es el diagnóstico. La interfaz toma su material de la señalética de estación de Lima: azul noche como túnel, una línea gruesa de extremos redondos, anillos como estaciones, carteles de estación con esquinas suaves y hojas diagonales del brochure como cortes entre secciones.",
    "keyCharacteristics": [
      "Una línea (8px, extremos redondos) conecta anillos en portada, pasos y llamado final.",
      "Cada sección declara --bg, --fg, --line y --btn-*; sobre oscuro la línea y el botón pasan a naranja.",
      "Plana por defecto: profundidad por cambio de fondo y cortes diagonales.",
      "Las diagonales son la única geometría no ortogonal."
    ],
    "rules": [
      { "name": "The Color-By-Name Rule", "body": "Las secciones guardan un nombre de color (background, surface, primary, accent, dark, text, muted, on_primary, on_dark) o un hex; el nombre se resuelve contra el tema vigente.", "section": "colors" },
      { "name": "The Readable-Ink Rule", "body": "El texto de cada sección se elige por contraste entre on_dark y text; el texto de botón es blanco o dark.", "section": "colors" },
      { "name": "The Orange-On-Night Rule", "body": "Línea y botón son azul sobre claro y naranja sobre oscuro.", "section": "colors" },
      { "name": "The Heavy-Head Rule", "body": "Titulares y números destacados son Sora 800 con tracking negativo.", "section": "typography" },
      { "name": "The Flat-Tunnel Rule", "body": "Tarjetas y tickets se separan con tinte y borde de 1px, no con sombra.", "section": "elevation" }
    ],
    "dos": [
      "Do colorear secciones por nombre del tema.",
      "Do usar la línea de 8px con anillos para toda secuencia.",
      "Do mantener botones de 48px mínimo y foco visible de 3px.",
      "Do respetar prefers-reduced-motion en la animación de la línea."
    ],
    "donts": [
      "Don't repetir tres tarjetas de ícono iguales.",
      "Don't usar azul sobre azul noche ni naranja sobre blanco como texto.",
      "Don't introducir sombras de decoración.",
      "Don't inventar clientes, cifras ni precios."
    ]
  }
